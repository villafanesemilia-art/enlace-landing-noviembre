# ---------- Formulario (obligatorio) ----------
# Endpoint de Formspree al que el formulario envía los datos desde el navegador.
# Formspree → tu formulario → pestaña Integration → "Form endpoint".
NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/mnppjqrl

# ---------- Cupo (máx. 12) ----------
# Bandera manual: true = "CUPOS AGOTADOS" y formulario deshabilitado
NEXT_PUBLIC_CUPOS_AGOTADOS=false
# Contador manual (opcional): cuántos lugares ya se ocuparon. Se usa solo si no hay conteo automático.
# NEXT_PUBLIC_CUPOS_OCUPADOS=0

# ---------- Opcionales: ya vienen con valores por defecto ----------
# Links de Mercado Pago (cada link tiene un monto fijo)
MP_LINK_FULL=https://mpago.la/2ptDyxz        # $35.000 (sin código)
MP_LINK_ENLACE02=https://mpago.la/22CTrdn    # $25.000 (código ENLACE02)

# Formulario de Formspree donde llegan las inscripciones (aviso por mail)
# (Solo para el conteo por API; si falta usa NEXT_PUBLIC_FORMSPREE_URL)
# FORMSPREE_ENDPOINT=

# ---------- Supabase: guarda cada inscripción en la tabla enlace_inscriptos ----------
# Solo en el servidor (Vercel). NUNCA con prefijo NEXT_PUBLIC.
# Project URL y Secret key (Project Settings → API Keys → "Secret keys")
# Con SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY cargadas, la landing guarda cada inscripción en Supabase además de Formspree.
# Conteo automático del cupo (opcional, ignora la bandera manual cuando llega a 12): CUPO_AUTO_COUNT=true

# ---------- Control de cupo (elegí UNA opción) ----------
# Opción A · Supabase (recomendada, funciona en plan gratis)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=enlace_inscriptos

# Opción B · Formspree (la API de lectura requiere plan Professional)
FORMSPREE_API_KEY=

# Freno de emergencia: true cierra la inscripción ya mismo
FORCE_SOLD_OUT=false

# Opcional: muestra el botón "Quiero ser parte" (Comunidad). Con código de país, sin +. Ej: 5493815551234
WHATSAPP_NUMBER=
